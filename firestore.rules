rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ── users ──────────────────────────────────────────────────────────────
    // All trading writes (balance, positions) go through the backend Admin SDK.
    // Clients only need to READ their own profile.
    // Self-registration (create) is still allowed from the client.
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // Only allow safe profile fields — no balance/role changes from client
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'updatedAt', 'lastLoginAt', 'brokeragePlan'])
      );
      allow delete: if isAdmin();

      // Legacy order subcollection — read only for client
      match /orders/{orderId} {
        allow read:  if isOwner(userId) || isAdmin();
        allow write: if false; // written by backend Admin SDK only
      }
    }

    // ── orders ─────────────────────────────────────────────────────────────
    // Written exclusively by the backend (Admin SDK). Clients read only.
    match /orders/{orderId} {
      allow read:  if isAdmin() ||
                      (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // backend Admin SDK only
    }

    // ── order_requests ─────────────────────────────────────────────────────
    // No longer used for trading — kept for any legacy reads.
    match /order_requests/{requestId} {
      allow read:   if isAdmin() ||
                       (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write:  if false; // backend Admin SDK only
    }

    // ── trades ─────────────────────────────────────────────────────────────
    match /trades/{tradeId} {
      allow read:  if isAdmin() ||
                      (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // backend Admin SDK only
    }

    // ── trade_feed ─────────────────────────────────────────────────────────
    match /trade_feed/{tradeId} {
      allow read:  if isAdmin();
      allow write: if false; // backend Admin SDK only
    }

    // ── portfolios/{uid}/holdings ───────────────────────────────────────────
    // Written by backend Admin SDK. Clients stream their own holdings.
    match /portfolios/{userId}/holdings/{stock} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if false; // backend Admin SDK only
    }

    // ── portfolios/{uid}/positions ──────────────────────────────────────────
    match /portfolios/{userId}/positions/{positionId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if false; // backend Admin SDK only
    }

    // ── ledger ─────────────────────────────────────────────────────────────
    match /ledger/{entryId} {
      allow read:  if isAdmin() ||
                      (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // backend Admin SDK only
    }

    // ── stocks ─────────────────────────────────────────────────────────────
    match /stocks/{stockId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── user_stock_leverage ────────────────────────────────────────────────
    match /user_stock_leverage/{docId} {
      allow read:  if isAdmin() ||
                      (isSignedIn() && docId.matches(request.auth.uid + '_.*'));
      allow write: if isAdmin();
    }

    // ── gtt_orders ─────────────────────────────────────────────────────────
    // GTT orders are still placed client-side (no backend route for them yet)
    match /gtt_orders/{gttId} {
      allow read:   if isAdmin() ||
                       (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() ||
                       (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() ||
                       (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── audit_logs ─────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      allow read:  if isAdmin();
      allow write: if false; // backend Admin SDK only
    }

    // ── notifications ──────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── admin_config ───────────────────────────────────────────────────────
    match /admin_config/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── risk_limits ────────────────────────────────────────────────────────
    match /risk_limits/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ── ipos ───────────────────────────────────────────────────────────────
    match /ipos/{ipoId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── withdrawal_requests ────────────────────────────────────────────────
    match /withdrawal_requests/{requestId} {
      allow read:   if isAdmin() ||
                       (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'PENDING' &&
                       request.resource.data.amount > 0;
      allow update, delete: if isAdmin();
    }
  }
}
