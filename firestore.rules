rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ── users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── orders ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read:   if isAdmin() ||
                       (request.auth != null &&
                        resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── trades ─────────────────────────────────────────────────────────────
    match /trades/{tradeId} {
      allow read:   if isAdmin() ||
                       (request.auth != null &&
                        resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── portfolios/{uid}/holdings/{stock} ───────────────────────────────────
    match /portfolios/{userId}/holdings/{stock} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── ledger ─────────────────────────────────────────────────────────────
    match /ledger/{entryId} {
      allow read:   if isAdmin() ||
                       (request.auth != null &&
                        resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── stocks ─────────────────────────────────────────────────────────────
    match /stocks/{stockId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ── user_stock_leverage ────────────────────────────────────────────────
    match /user_stock_leverage/{docId} {
      allow read:  if isAdmin() ||
                      (request.auth != null &&
                       docId.matches(request.auth.uid + '_.*'));
      allow write: if isAdmin();
    }

    // ── audit_logs ─────────────────────────────────────────────────────────
    // FIXED: was `allow write: if request.auth != null` — any user could inject
    // fake audit entries. Now only admins can write audit logs.
    match /audit_logs/{logId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ── notifications ──────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ── trade_feed (denormalized admin feed) ───────────────────────────────
    // FIXED: was `allow create: if request.auth != null` — any user could inject
    // fake trades into the admin live feed. Now only admins can read/write.
    // Writes happen server-side inside the Firestore transaction (client SDK
    // running as the authenticated user), so the create rule must allow the
    // owning user to write their own trade feed entry.
    match /trade_feed/{tradeId} {
      allow read:   if isAdmin();
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── admin_config ───────────────────────────────────────────────────────
    match /admin_config/{docId} {
      allow read:  if request.auth != null; // users need to read globalTradingHalt
      allow write: if isAdmin();
    }

    // ── risk_limits ────────────────────────────────────────────────────────
    match /risk_limits/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
